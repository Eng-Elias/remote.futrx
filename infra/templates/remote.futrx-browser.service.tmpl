[Unit]
Description=remote.futrx — shared Chromium browser broker
After=network-online.target lxd.service
Wants=network-online.target

[Service]
Type=simple
User=remote-browser
Group=remote-browser
WorkingDirectory=${INSTALL_DIR}/browser-broker
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x720x24 -nolisten tcp" /usr/bin/node ${INSTALL_DIR}/browser-broker/src/server.mjs
Environment=NODE_ENV=production
Environment=HOME=${INSTALL_DIR}/data/browser-broker/home
Environment=PLAYWRIGHT_BROWSERS_PATH=${INSTALL_DIR}/data/browser-broker/browsers
Environment=BROWSER_BROKER_HOST=${LXD_BRIDGE_IP}
Environment=BROWSER_BROKER_PORT=9323
Environment=BROWSER_BROKER_SECRET_FILE=${INSTALL_DIR}/data/browser-broker.secret
Environment=BROWSER_BROKER_DATA_DIR=${INSTALL_DIR}/data/browser-broker/contexts
Environment=BROWSER_BROKER_OUTPUT_DIR=/run/remote-futrx-browser/output
Environment=BROWSER_PROCESS_IDLE_MS=30000
Environment=BROWSER_STATE_SAVE_MS=60000
Environment=BROWSER_MAX_CONTEXTS=32
Restart=always
RestartSec=2
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=remote-futrx-browser
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${INSTALL_DIR}/data/browser-broker
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=2G
MemoryMax=3G
TasksMax=512

[Install]
WantedBy=multi-user.target
